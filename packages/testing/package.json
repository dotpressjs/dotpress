{
  "name": "@dotpress/testing",
  "version": "2.0.0-alpha.5",
  "description": "Testing helpers for Dotpress: test app, conformance suite, event and mail assertions",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotpressjs/dotpress.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/dotpressjs/dotpress/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "@dotpress/core": "workspace:^",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@dotpress/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dotpress",
    "testing",
    "conformance",
    "assertions"
  ]
}
