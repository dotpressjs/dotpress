{
  "name": "@dotpress-examples/events",
  "version": "0.0.0",
  "private": true,
  "description": "Dotpress events: an API emitting events, and listeners run by a worker through Redis (BullMQ)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "worker": "dotpress-events work src/worker.ts --watch",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@dotpress/adapter-fastify": "^2.0.0-alpha.2",
    "@dotpress/core": "^2.0.0-alpha.2",
    "@dotpress/events": "^2.0.0-alpha.2",
    "bullmq": "^6.7.2",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dotpress/testing": "^2.0.0-alpha.2",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
