{
  "name": "@dotpress/events",
  "version": "2.0.0-alpha.0",
  "description": "Typed events with listeners, delivered by interchangeable transports (SQS, Redis, Cloudflare Queues, Postgres, Pub/Sub, Service Bus)",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/renoguyon/dotpress",
    "directory": "packages/events"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dotpress-events": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./sqs": {
      "types": "./dist/sqs.d.ts",
      "default": "./dist/sqs.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq.d.ts",
      "default": "./dist/bullmq.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./pg-boss": {
      "types": "./dist/pg-boss.d.ts",
      "default": "./dist/pg-boss.js"
    },
    "./pubsub": {
      "types": "./dist/pubsub.d.ts",
      "default": "./dist/pubsub.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "@aws-sdk/client-sqs": "^3.572.0",
    "@dotpress/core": "workspace:^",
    "@google-cloud/pubsub": "^6.0.0",
    "bullmq": "^6.0.0",
    "google-auth-library": "^10.0.0 || ^11.0.0",
    "jose": "^6.0.0",
    "pg-boss": "^12.21.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@dotpress/core": {
      "optional": true
    },
    "@google-cloud/pubsub": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "google-auth-library": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "pg-boss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@dotpress/core": "workspace:*",
    "@dotpress/testing": "workspace:*",
    "@google-cloud/pubsub": "~6.3.2",
    "bullmq": "^6.7.2",
    "google-auth-library": "~11.3.4",
    "ioredis": "^5.11.1",
    "jose": "~6.2.15",
    "pg-boss": "~12.38.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dotpress",
    "events",
    "listeners",
    "queue",
    "worker",
    "plugin",
    "typescript",
    "sqs",
    "aws",
    "lambda",
    "bullmq",
    "redis",
    "cloudflare",
    "workers",
    "postgres",
    "pg-boss",
    "pubsub",
    "gcp"
  ]
}
