{
  "name": "@dotpress/cache",
  "version": "2.0.0-alpha.0",
  "description": "Request memoization with batching, and a resilient cache with interchangeable stores",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/renoguyon/dotpress",
    "directory": "packages/cache"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./als": {
      "types": "./dist/als.d.ts",
      "default": "./dist/als.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "@dotpress/core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@dotpress/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dotpress/core": "workspace:*",
    "@dotpress/testing": "workspace:*",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dotpress",
    "cache",
    "memoization",
    "dataloader",
    "batching",
    "single-flight",
    "typescript",
    "plugin",
    "asynclocalstorage"
  ]
}
