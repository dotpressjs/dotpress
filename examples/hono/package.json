{
  "name": "@dotpress-examples/hono",
  "version": "0.0.0",
  "private": true,
  "description": "One Dotpress app on Hono, served by Node.js and by AWS Lambda",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/node.ts",
    "dev": "node --watch src/node.ts",
    "build:lambda": "esbuild src/lambda.ts --bundle --minify --platform=node --target=node22 --format=esm --outfile=dist/lambda.mjs",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@dotpress/adapter-hono": "^2.0.0-alpha.4",
    "@dotpress/core": "^2.0.0-alpha.4",
    "@hono/aws-lambda": "^1.0.1",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dotpress/testing": "^2.0.0-alpha.4",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
