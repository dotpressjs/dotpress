{
  "name": "@dotpress/adapter-hono",
  "version": "2.0.0-beta.0",
  "description": "Hono adapter for Dotpress, on Node.js and AWS Lambda",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotpressjs/dotpress.git",
    "directory": "packages/adapter-hono"
  },
  "bugs": {
    "url": "https://github.com/dotpressjs/dotpress/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./lambda": {
      "types": "./dist/lambda.d.ts",
      "default": "./dist/lambda.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "@dotpress/core": "workspace:^",
    "@hono/aws-lambda": "^1.0.0",
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.0"
  },
  "peerDependenciesMeta": {
    "@hono/aws-lambda": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dotpress/core": "workspace:*",
    "@dotpress/testing": "workspace:*",
    "@hono/aws-lambda": "^1.0.1",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "hono-5": "npm:hono@5.0.0-rc.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dotpress",
    "hono",
    "adapter",
    "aws-lambda",
    "typescript",
    "zod"
  ]
}
