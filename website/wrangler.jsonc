// The documentation site, served by Cloudflare Workers as static assets (no
// Worker script). Deployed by the Release workflow after each release.
{
  "name": "dotpress-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Built by `rspress build`.
    "directory": "./doc_build",
    // /adapters/express serves adapters/express.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Custom domains: Cloudflare creates their DNS records and certificates.
  // www.dotpress.dev is redirected to dotpress.dev by a redirect rule of the
  // zone, which runs before the Worker.
  "routes": [
    { "pattern": "dotpress.dev", "custom_domain": true },
    { "pattern": "www.dotpress.dev", "custom_domain": true },
  ],
  // Served on dotpress.dev only.
  "workers_dev": false,
  "preview_urls": false,
}
