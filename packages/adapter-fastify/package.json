{
  "name": "@dotpress/adapter-fastify",
  "version": "2.0.0-alpha.0",
  "description": "Fastify 5 adapter for Dotpress, on Node.js and AWS Lambda",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/renoguyon/dotpress",
    "directory": "packages/adapter-fastify"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lambda": {
      "types": "./dist/lambda.d.ts",
      "default": "./dist/lambda.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "@dotpress/core": "workspace:^",
    "@fastify/aws-lambda": "^6.1.0",
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@fastify/aws-lambda": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dotpress/core": "workspace:*",
    "@dotpress/testing": "workspace:*",
    "@fastify/aws-lambda": "^6.4.2",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dotpress",
    "fastify",
    "adapter",
    "aws-lambda",
    "typescript",
    "zod"
  ]
}
