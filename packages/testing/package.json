{
  "name": "@dotpress/testing",
  "version": "2.0.0-alpha.0",
  "description": "Testing helpers for Dotpress, including the adapter conformance suite",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/renoguyon/dotpress",
    "directory": "packages/testing"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@dotpress/core": "workspace:^",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@dotpress/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dotpress",
    "testing",
    "conformance"
  ]
}
