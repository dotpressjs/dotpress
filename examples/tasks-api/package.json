{
  "name": "@dotpress-examples/tasks-api",
  "version": "0.0.0",
  "private": true,
  "description": "A team task manager with Dotpress: auth, projects and tasks, cache, OpenAPI, on Fastify and SQLite",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "seed": "node src/seed.ts",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@dotpress/adapter-fastify": "^2.0.0-alpha.1",
    "@dotpress/auth": "^2.0.0-alpha.1",
    "@dotpress/cache": "^2.0.0-alpha.1",
    "@dotpress/core": "^2.0.0-alpha.1",
    "@dotpress/openapi": "^2.0.0-alpha.1",
    "fastify": "^5.12.8",
    "redis": "~6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dotpress/testing": "^2.0.0-alpha.1",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
