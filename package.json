{
  "name": "dotpress-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:core": "node scripts/check-core-agnostic.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "api:check": "node scripts/api-report.mjs --check",
    "api:update": "node scripts/api-report.mjs",
    "test:packed": "node scripts/test-packed.mjs",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "release:dry-run": "node scripts/release-dry-run.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "~0.18.5",
    "@changesets/changelog-github": "~1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "publint": "~0.3.25",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
