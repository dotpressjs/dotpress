{
  "name": "@dotpress/mailer",
  "version": "2.0.0-alpha.0",
  "description": "Typed, multilingual email templates (MJML or HTML) and interchangeable providers",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/renoguyon/dotpress",
    "directory": "packages/mailer"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "@dotpress/core": "workspace:^",
    "mjml": "^5.0.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@dotpress/core": {
      "optional": true
    },
    "mjml": {
      "optional": true
    }
  },
  "dependencies": {
    "html-to-text": "^10.0.1",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@dotpress/core": "workspace:*",
    "@dotpress/testing": "workspace:*",
    "@types/html-to-text": "^9.0.4",
    "@types/mjml": "^5.4.2",
    "@types/mustache": "^4.2.6",
    "mjml": "^5.4.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dotpress",
    "email",
    "mailer",
    "plugin",
    "mjml",
    "i18n",
    "templates",
    "typescript"
  ]
}
