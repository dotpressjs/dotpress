{
  "name": "dotpress",
  "version": "1.2.2",
  "description": "Dotpress - Modern express microframework for Typescript backends",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/renoguyon/dotpress",
    "directory": "packages/dotpress"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.12",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "keywords": [
    "express",
    "typescript",
    "zod",
    "http",
    "api",
    "middleware",
    "validation",
    "framework",
    "node",
    "backend",
    "rest",
    "dotpress"
  ]
}
