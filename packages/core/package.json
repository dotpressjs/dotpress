{
  "name": "@dotpress/core",
  "version": "2.0.0-alpha.4",
  "description": "Lightweight, decorator-free TypeScript framework for end-to-end typed HTTP APIs, independent of the underlying HTTP server",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotpressjs/dotpress.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/dotpressjs/dotpress/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  },
  "keywords": [
    "typescript",
    "zod",
    "http",
    "api",
    "framework",
    "backend",
    "rest",
    "dotpress"
  ]
}
