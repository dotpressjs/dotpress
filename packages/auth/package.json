{
  "name": "@dotpress/auth",
  "version": "2.0.0-alpha.5",
  "description": "JWT authentication plugin for Dotpress",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotpressjs/dotpress.git",
    "directory": "packages/auth"
  },
  "bugs": {
    "url": "https://github.com/dotpressjs/dotpress/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "@dotpress/core": "workspace:^",
    "zod": "^4.6.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@dotpress/core": "workspace:*",
    "@dotpress/testing": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dotpress",
    "auth",
    "authentication",
    "jwt",
    "plugin",
    "typescript"
  ]
}
