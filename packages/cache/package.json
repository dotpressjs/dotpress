{
  "name": "@dotpress/cache",
  "version": "2.0.0-alpha.5",
  "description": "Request memoization with batching, and a resilient cache with interchangeable stores",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotpressjs/dotpress.git",
    "directory": "packages/cache"
  },
  "bugs": {
    "url": "https://github.com/dotpressjs/dotpress/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./als": {
      "types": "./dist/als.d.ts",
      "default": "./dist/als.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "default": "./dist/redis.js"
    },
    "./upstash": {
      "types": "./dist/upstash.d.ts",
      "default": "./dist/upstash.js"
    },
    "./cloudflare-kv": {
      "types": "./dist/cloudflare-kv.d.ts",
      "default": "./dist/cloudflare-kv.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "@dotpress/core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@dotpress/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dotpress/core": "workspace:*",
    "@dotpress/testing": "workspace:*",
    "ioredis": "~6.0.0",
    "miniflare": "~4.20260730.0",
    "redis": "~6.3.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dotpress",
    "cache",
    "memoization",
    "dataloader",
    "batching",
    "single-flight",
    "typescript",
    "plugin",
    "asynclocalstorage",
    "redis",
    "valkey",
    "upstash",
    "cloudflare",
    "workers",
    "kv"
  ]
}
