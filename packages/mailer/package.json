{
  "name": "@dotpress/mailer",
  "version": "2.0.0-alpha.4",
  "description": "Typed, multilingual email templates (MJML or HTML) and interchangeable providers",
  "author": "Renaud Guyon",
  "license": "MIT",
  "homepage": "https://dotpress.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotpressjs/dotpress.git",
    "directory": "packages/mailer"
  },
  "bugs": {
    "url": "https://github.com/dotpressjs/dotpress/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./smtp": {
      "types": "./dist/smtp.d.ts",
      "default": "./dist/smtp.js"
    },
    "./aws-ses": {
      "types": "./dist/aws-ses.d.ts",
      "default": "./dist/aws-ses.js"
    },
    "./resend": {
      "types": "./dist/resend.d.ts",
      "default": "./dist/resend.js"
    },
    "./sendgrid": {
      "types": "./dist/sendgrid.d.ts",
      "default": "./dist/sendgrid.js"
    },
    "./postmark": {
      "types": "./dist/postmark.d.ts",
      "default": "./dist/postmark.js"
    },
    "./brevo": {
      "types": "./dist/brevo.d.ts",
      "default": "./dist/brevo.js"
    },
    "./mailjet": {
      "types": "./dist/mailjet.d.ts",
      "default": "./dist/mailjet.js"
    },
    "./mailgun": {
      "types": "./dist/mailgun.d.ts",
      "default": "./dist/mailgun.js"
    },
    "./scaleway": {
      "types": "./dist/scaleway.d.ts",
      "default": "./dist/scaleway.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "@aws-sdk/client-sesv2": "^3.782.0",
    "@dotpress/core": "workspace:^",
    "mjml": "^5.0.0",
    "nodemailer": "^10.0.0",
    "resend": "^6.0.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "@dotpress/core": {
      "optional": true
    },
    "mjml": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "resend": {
      "optional": true
    }
  },
  "dependencies": {
    "html-to-text": "^10.0.1",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "^3.1164.0",
    "@dotpress/core": "workspace:*",
    "@dotpress/testing": "workspace:*",
    "@types/html-to-text": "^9.0.4",
    "@types/mjml": "^5.4.2",
    "@types/mustache": "^4.2.6",
    "mjml": "^5.4.1",
    "nodemailer": "^10.4.0",
    "resend": "^6.37.0",
    "smtp-server": "^3.21.3",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dotpress",
    "email",
    "mailer",
    "plugin",
    "mjml",
    "i18n",
    "templates",
    "typescript",
    "smtp",
    "nodemailer",
    "aws-ses",
    "aws",
    "resend",
    "sendgrid",
    "postmark",
    "brevo",
    "mailjet",
    "mailgun",
    "scaleway"
  ]
}
